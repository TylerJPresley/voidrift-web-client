{
  "name": "voidrift-web-client",
  "version": "0.1.0",
  "description": "VoidRift Web UI frontend — the thin browser client: SSR shell, streaming transcript, approvals, panels, accessible (WCAG 2.1 AA). Reaches the SDK only through the web-server HTTP + WebSocket surface (web-blueprint.md).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "product"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-web-client.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-web-client/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-web-client#readme",
  "keywords": [
    "voidrift",
    "web",
    "frontend",
    "thin",
    "browser"
  ]
}
